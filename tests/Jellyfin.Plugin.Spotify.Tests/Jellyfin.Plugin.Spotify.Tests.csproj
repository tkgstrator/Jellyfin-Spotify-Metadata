<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <!-- xunit v3 runs on Microsoft.Testing.Platform: test projects are executables. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Jellyfin.Plugin.Spotify.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- FakeTimeProvider: the token provider's expiry window is a clock
         behaviour, and waiting an hour in a test is not an option. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The plugin excludes the Jellyfin runtime assemblies (the server supplies
      them). Tests run outside the server, so they must reference them normally.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Jellyfin.Plugin.Spotify/Jellyfin.Plugin.Spotify.csproj" />
  </ItemGroup>

</Project>
